# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node
node_modules/
dist/

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Environment
.env
.env.local

# Runtime data — regenerated by setup.sh on a fresh clone.
# SQLite DBs, ChromaDB vector store, generated KB descriptor.
backend/data/
# User-uploaded KB files. Empty on a fresh clone; upload via the UI.
backend/uploads/

# Generated by app.agent.studio_setup — reflects the DB-backed agent set
# and is rewritten on app startup / agent CRUD. Don't commit.
backend/langgraph.json

# LangGraph dev server's local runtime cache (in-memory checkpointer
# pickles, etc.) — regenerated each `langgraph dev` boot. Don't commit.
backend/.langgraph_api/

# Backend log tap file used transiently during UI tests.
/tmp/finchat-backend.log

# Logs
*.log

# Local Claude Code state — do not share.
.claude/
